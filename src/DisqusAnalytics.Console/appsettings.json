{
  "Application": {
    "Name": "Disqus Analytics",
    "Version": "1.0.0"
  },
  "Disqus": {
    "ApiKey": "",
    "ApiSecret": "",
    "Forum": "",
    "BaseUrl": "https://disqus.com/api/3.0/",
    "RequestDelayMilliseconds": 250
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/disqus.db"
  },
  "Analytics": {
    "OutputPath": "docs/statistics.json",
    "TopAuthors": 25,
    "TopDiscussions": 25,
    "TopWords": 100,
    "MinimumWordLength": 3
  },
  "Forums": [
    {
      "Name": "RPGuaxa",
      "Forum": "scicastpodcast",
      "Filters": {
        "TitleContains": [
          "RPGuaxa"
        ],
        "TitleExclude": [
          "Guaxaverso"
        ]
      }
    },
    {
      "Name": "Guaxaverso",
      "Forum": "scicastpodcast",
      "Filters": {
        "TitleContains": [
          "Guaxaverso"
        ],
        "TitleExclude": []
      }
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "DisqusAnalytics": "Information",
      "DisqusAnalytics.Disqus": "Information",
      "DisqusAnalytics.Sync": "Information",
      "DisqusAnalytics.Analytics": "Information",
      "DisqusAnalytics.Persistence": "Information"
    }
  }
}
